# ---------------------------------------------------------------------------
# SiteOps backend environment configuration
#
# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.
# Every variable below is validated at startup; a missing or malformed required
# value stops the process rather than letting it run misconfigured.
#
# The dashboard (siteOps-client) reads none of this. Its only configuration is
# two NEXT_PUBLIC_* origins; see that repository's own `.env.example`.
# ---------------------------------------------------------------------------

# --- Shared ----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# Public origin of the dashboard. Used for CORS, cookies and every link in an
# outgoing email.
APP_URL=http://localhost:3000
# Public origin of this API. Used to build absolute callback URLs.
API_URL=http://localhost:4000

# --- Database --------------------------------------------------------------
# Local development uses the Docker Compose service (`pnpm docker:up`), which
# runs a single-node replica set. Production uses a MongoDB Atlas connection
# string. The replica set is required for the one transaction SiteOps uses:
# creating an organization together with its first membership.
MONGODB_URI=mongodb://localhost:27017/siteops?replicaSet=rs0&directConnection=true
# The API and the worker each hold their own pool; the sum must stay under the
# cluster's connection limit.
MONGODB_MAX_POOL_SIZE=10
# Runs the index sync at startup. Convenient locally, wrong in production: an
# index build issued by a starting process can stall a live cluster. Deploy with
# this false and run `pnpm indexes:sync` as an explicit step. Without one or the
# other the database enforces none of the uniqueness the product relies on —
# duplicate incidents and repeated alert emails included.
MONGODB_AUTO_INDEX=true

# --- Authentication --------------------------------------------------------
# Signing key for sessions and email tokens. Minimum 32 characters.
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-at-least-32-random-characters
# Only needed when the API and dashboard are served from different hosts under
# one registrable domain, e.g. api.siteops.app and app.siteops.app.
# COOKIE_DOMAIN=.siteops.app

# --- Email -----------------------------------------------------------------
# Required in production. Without it, verification and outage emails are logged
# instead of sent — fine locally, unacceptable in production.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=SiteOps <onboarding@resend.dev>

# --- API -------------------------------------------------------------------
PORT=4000
# Extra browser origins allowed to send credentialed requests, comma-separated.
# ADDITIONAL_TRUSTED_ORIGINS=https://staging.siteops.app
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
AUTH_RATE_LIMIT_MAX_REQUESTS=10
# Enable ONLY behind a proxy that sets X-Forwarded-For. With no proxy in front,
# enabling it lets any client spoof its address and defeat rate limiting.
TRUST_PROXY=false

# --- Monitoring worker -----------------------------------------------------
WORKER_PORT=4001
# How often the scheduler looks for websites that are due for a check.
MONITOR_POLL_INTERVAL_SECONDS=15
# Websites checked simultaneously. Raise only with the outbound bandwidth to match.
MONITOR_CONCURRENCY=10
MONITOR_MAX_REDIRECTS=5
# Attempts per scheduled check, including the first. Absorbs a single blip
# without waiting for the whole failure threshold to be crossed.
MONITOR_MAX_ATTEMPTS=2
# Delivery attempts for one alert email before it is recorded as failed.
NOTIFICATION_MAX_ATTEMPTS=3
# How long raw check documents are kept. Also the TTL index's expiry, so a
# change here needs `pnpm indexes:sync` to take effect.
CHECK_RETENTION_DAYS=90
# Set true ONLY in automated tests, which need to reach a mock server on
# loopback. Refused outright in production: it disables SSRF protection.
MONITOR_ALLOW_PRIVATE_ADDRESSES=false

# --- Reports ---------------------------------------------------------------
# How often the worker looks for queued reports and schedules that are due.
REPORT_POLL_INTERVAL_SECONDS=60
# Reports built per tick. Each is a burst of aggregation over the check history,
# so this bounds how much database load report generation can add at once.
REPORT_BATCH_SIZE=3

# --- Performance monitoring ------------------------------------------------
# Google PageSpeed Insights API key. Optional, and strongly recommended.
#
# With it, the performance monitor gets real Lighthouse scores and real Core
# Web Vitals, measured by Google in a real Chrome. Without it, the monitor
# falls back to server-side measurement: time to first byte, page weight and
# render-blocking resource count, with no Lighthouse score and no LCP or CLS —
# because those cannot be measured without rendering the page, and inventing
# them would be worse than omitting them. Every result names which produced it.
#
# Create one at https://console.cloud.google.com with the PageSpeed Insights
# API enabled. The free quota is 25,000 requests a day.
# PAGESPEED_API_KEY=AIza...

# --- Billing ---------------------------------------------------------------
# Stripe. Every variable below is optional, and leaving them unset is a fully
# supported configuration: no payment provider is constructed, the billing
# routes answer `BILLING_NOT_CONFIGURED`, and the dashboard's billing page says
# so plainly. SiteOps runs perfectly well on the free plan without ever
# charging anyone — what it must never do is pretend a checkout happened.
#
# Setting STRIPE_SECRET_KEY without STRIPE_WEBHOOK_SECRET is refused at startup:
# a deployment that can take money but cannot verify that it did would leave
# every subscription stuck at whatever it was when checkout opened.
#
# A live key (sk_live_) is refused outside production, so a development machine
# cannot charge a real card.
#
# Setup:
#   1. Create the products and prices in the Stripe dashboard (or with the CLI)
#      and copy each price id below. A plan with no price id is simply not sold
#      by this deployment: the pricing page still describes it, and checkout
#      refuses it with a clear message.
#   2. Add a webhook endpoint pointing at `<API_URL>/api/billing/webhook`,
#      subscribed to:
#        checkout.session.completed
#        customer.subscription.created
#        customer.subscription.updated
#        customer.subscription.deleted
#      then copy its signing secret into STRIPE_WEBHOOK_SECRET.
#   3. Locally, `stripe listen --forward-to localhost:4000/api/billing/webhook`
#      prints a `whsec_...` to use instead.
#
# The prices shown on the pricing page live in `src/contracts/domain/billing.ts`
# and are display only. The amount a customer is charged always comes from the
# Stripe price these ids name.
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# Professional ($19/month, $190/year)
# STRIPE_PRICE_STARTER_MONTHLY=price_xxxxxxxxxxxxxxxxxxxx
# STRIPE_PRICE_STARTER_YEARLY=price_xxxxxxxxxxxxxxxxxxxx
# Agency ($79/month, $790/year)
# STRIPE_PRICE_AGENCY_MONTHLY=price_xxxxxxxxxxxxxxxxxxxx
# STRIPE_PRICE_AGENCY_YEARLY=price_xxxxxxxxxxxxxxxxxxxx
# Pro ($199/month, $1990/year)
# STRIPE_PRICE_PRO_MONTHLY=price_xxxxxxxxxxxxxxxxxxxx
# STRIPE_PRICE_PRO_YEARLY=price_xxxxxxxxxxxxxxxxxxxx
