{
  "name": "siteops-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SiteOps API and monitoring worker: the backend for the SiteOps dashboard.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,worker -c blue,green \"pnpm dev:api\" \"pnpm dev:worker\"",
    "dev:api": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps --env-file-if-exists=.env dist/server.js",
    "start:worker": "node --enable-source-maps --env-file-if-exists=.env dist/worker.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write \"**/*.{ts,mts,js,mjs,cjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,mts,js,mjs,cjs,json,md,yml,yaml}\"",
    "migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "indexes:sync": "tsx --env-file-if-exists=.env scripts/sync-indexes.ts",
    "indexes:verify": "tsx --env-file-if-exists=.env scripts/verify-indexes.ts",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "clean": "rimraf dist coverage *.tsbuildinfo",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "better-auth": "1.7.2",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "mongodb": "7.5.0",
    "mongoose": "9.9.4",
    "pdfkit": "0.20.2",
    "pino": "10.3.1",
    "resend": "6.25.0",
    "undici": "8.10.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "26.4.1",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "4.1.11",
    "concurrently": "10.0.5",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-n": "18.0.0",
    "globals": "17.12.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  }
}
